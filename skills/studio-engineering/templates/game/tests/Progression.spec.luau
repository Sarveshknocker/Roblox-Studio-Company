local Progression = require("../src/shared/Pure/Progression")

return function(t)
	t.it("xpToNext matches the design simulator formula base × level^exponent", function()
		t.near(Progression.xpToNext(1, 100, 1.45), 100)
		t.near(Progression.xpToNext(4, 100, 1.5), 800)
	end)
	t.it("addXp handles several level-ups and keeps leftover XP", function()
		local level, xp = Progression.addXp(1, 0, 100 + 200 + 50, 100, 1, 60)
		t.eq(level, 3)
		t.near(xp, 50)
	end)
	t.it("addXp stops at the max level", function()
		local level = Progression.addXp(59, 0, 1e9, 100, 1, 60)
		t.eq(level, 60)
	end)
	t.it("incomePerMinute applies level growth, upgrades and multiplier", function()
		t.near(Progression.incomePerMinute(120, 0.08, 1, 0, 1), 120)
		t.near(Progression.incomePerMinute(120, 0.08, 6, 0.25, 2), 120 * 1.4 * 1.25 * 2)
	end)
end
