local RateLimiter = require("../src/shared/Pure/RateLimiter")

return function(t)
	t.it("allows a burst, then blocks until tokens refill", function()
		local limiter = RateLimiter.new(3, 1)
		t.eq(limiter:allow("p1", 0), true)
		t.eq(limiter:allow("p1", 0), true)
		t.eq(limiter:allow("p1", 0), true)
		t.eq(limiter:allow("p1", 0), false, "4th request in the same instant")
		t.eq(limiter:allow("p1", 1), true, "one token refilled after 1 s")
		t.eq(limiter:allow("p1", 1), false)
	end)
	t.it("keeps players independent and forgets them on leave", function()
		local limiter = RateLimiter.new(1, 0.5)
		t.eq(limiter:allow("a", 0), true)
		t.eq(limiter:allow("b", 0), true)
		t.eq(limiter:allow("a", 0), false)
		limiter:forget("a")
		t.eq(limiter:allow("a", 0), true, "a fresh bucket after forget")
	end)
	t.it("never exceeds capacity after a long idle time", function()
		local limiter = RateLimiter.new(2, 10)
		t.eq(limiter:allow("p", 0), true)
		t.eq(limiter:allow("p", 1000), true)
		t.eq(limiter:allow("p", 1000), true)
		t.eq(limiter:allow("p", 1000), false)
	end)
end
